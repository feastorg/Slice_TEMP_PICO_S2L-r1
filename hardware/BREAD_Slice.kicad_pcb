			(svgprecision 6)
			(plotframeref no)
			(mode 1)
			(useauxorigin yes)
			(hpglpennumber 1)
			(hpglpenspeed 20)
			(hpglpendiameter 15.000000)
			(pdf_front_fp_property_popups yes)
